{
  "name": "replication-empirical-llm-tests",
  "version": "0.1.0",
  "description": "Replication infrastructure for empirical evaluation of LLM-based unit test generation.",
  "type": "module",
  "private": true,
  "scripts": {
    "collect:functions": "tsx src/experiment/collectApiFunctions.ts",
    "estimate:tokens": "tsx src/experiment/estimateTokens.ts",
    "generate:prompts": "tsx src/experiment/generatePrompts.ts",
    "generate:tests:llm": "tsx src/experiment/generateTestsWithLLM.ts",
    "materialize:tests": "tsx src/experiment/materializeTests.ts",
    "run:coverage": "tsx src/experiment/runCoverage.ts",
    "run:tests": "tsx src/experiment/runGeneratedTests.ts",
    "sample:functions": "tsx src/experiment/sampleApiFunctions.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "complex.js": "^2.4.2",
    "countries-and-timezones": "^3.8.0",
    "geo-point": "^2.0.1",
    "plural": "^0.2.0",
    "quill-delta": "^5.1.0",
    "simple-statistics": "^7.9.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3"
  }
}
